---
<button class="theme-toggle" aria-label="Przełącz motyw" aria-pressed="false">
  <span class="theme-icon sun-icon" aria-hidden="true">☀️</span>
  <span class="theme-icon moon-icon" aria-hidden="true">🌙</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .theme-toggle:hover {
    background: var(--blue-light);
  }
  .theme-icon {
    font-size: 1.1rem;
    line-height: 1;
  }
  .moon-icon { display: none; }
  .theme-toggle[aria-pressed="true"] .sun-icon { display: none; }
  .theme-toggle[aria-pressed="true"] .moon-icon { display: block; }
</style>

<script>
  const toggle = document.querySelector('.theme-toggle');
  const html = document.documentElement;
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  const apply = (isDark: boolean) => {
    html.classList.toggle('dark', isDark);
    toggle?.setAttribute('aria-pressed', isDark ? 'true' : 'false');
  };

  // Reflect the current theme on the button. The `.dark` class itself is set
  // pre-render by the inline script in <head> (no flash).
  const saved = localStorage.getItem('theme');
  apply(saved ? saved === 'dark' : mq.matches);

  // Explicit user choice — persist it.
  toggle?.addEventListener('click', () => {
    const isDark = !html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    apply(isDark);
  });

  // Follow the OS setting live, but only until the user picks a theme explicitly.
  mq.addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) apply(e.matches);
  });
</script>