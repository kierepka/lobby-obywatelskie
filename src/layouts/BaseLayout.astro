---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { asset } from '../lib/site';
import '../styles/global.css';
import '../styles/dark.css';
interface Props { title: string; description?: string; }
const { title, description = 'Lobby Obywatelskie — ruch demokracji bezpośredniej. Razem możemy więcej.' } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={asset('/img/logo-mark.png')} />
    <script is:inline>
      // Set the theme class before first paint (no flash).
      // Default: the saved choice, otherwise the OS preference.
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved ? saved === 'dark' : prefersDark) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>