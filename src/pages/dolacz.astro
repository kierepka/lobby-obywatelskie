---
import { url } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Dołącz do nas — Lobby Obywatelskie">
  <header class="page-hero container">
    <p class="eyebrow">Dołącz do nas</p>
    <h1>Połącz się z nami</h1>
    <p class="lede">Spotykamy się w każdą środę o 22:00. Napisz — odpowiadamy.</p>
    <div class="hero-actions">
      <a class="btn" href="https://lobbyobywatelskie.wikikracja.pl" target="_blank" rel="noopener noreferrer">Zarejestruj się</a>
      <a class="btn btn--ghost" href="https://rozmowy.wikikracja.pl/otwarte" target="_blank" rel="noopener noreferrer">Dołącz do spotkania</a>
      <a class="btn btn--ghost" href={url('/kontakt')}>Napisz do nas</a>
    </div>
  </header>

  <style>
    .page-hero { padding: clamp(2.5rem, 6vw, 4rem) 1.5rem; border-bottom: 1px solid var(--line); margin-bottom: 0; }
    .page-hero h1 { font-size: var(--step-3); margin: 0 0 1rem; }
    .page-hero .lede { font-size: var(--step-1); max-width: 34rem; color: #34373d; margin: 0 0 1.75rem; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .85rem; }
  </style>
</BaseLayout>
